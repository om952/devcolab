# Root env file consumed by docker-compose.
# Copy to .env and fill in before running `docker compose up`.

# --- Secrets (required) ---
# Generate each with: openssl rand -hex 32
JWT_SECRET=
INTERNAL_API_KEY=

# --- Database ---
# Only used by the bundled Postgres container (docker-compose.yml). Ignored
# entirely when deploying with docker-compose.neon.yml.
POSTGRES_USER=devcolab
POSTGRES_PASSWORD=devcolab
POSTGRES_DB=devcolab

# --- External database (Neon or any managed Postgres) ---
# Required only when deploying with docker-compose.neon.yml — see README
# "Using Neon" section. Get both from the Neon dashboard: DATABASE_URL is the
# pooled connection (host has "-pooler" in it), DIRECT_URL is the unpooled one
# Prisma Migrate needs. Both need ?sslmode=require.
#   DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/devcolab?sslmode=require
#   DIRECT_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/devcolab?sslmode=require
DATABASE_URL=
DIRECT_URL=

# --- Networking ---
# Browser origin(s) allowed to call the APIs. Comma-separated.
CORS_ORIGIN=http://localhost:3000

# Baked into the web client at build time. Must be URLs the browser can reach.
NEXT_PUBLIC_COLLAB_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000

# Proxy hops to trust for client IPs. 0 when exposed directly, 1 behind one LB.
TRUST_PROXY=1

# Brute-force budget for login/register, per IP. The default (20 per 15 min)
# suits a public signup page; raise it if your users share an egress IP.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000

# --- LLM ---
# There is no server-side provider key: each user adds their own Gemini or Groq
# key in the app, held in collab-server memory for LLM_KEY_TTL_MS (default 8h).
# Only the models are configured here.
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=llama-3.1-8b-instant

# --- Observability (optional) ---
SENTRY_DSN=

# --- Production deployment (docker-compose.prod.yml) ---
# Public hostnames. Both must resolve to the host before starting Caddy,
# which uses them to issue TLS certificates automatically.
DEVCOLAB_DOMAIN=devcolab.example.com
DEVCOLAB_API_DOMAIN=api.devcolab.example.com

# Log level for collab-server (fatal|error|warn|info|debug|trace|silent)
LOG_LEVEL=info

# Optional OTLP endpoint for traces. Unset = telemetry disabled.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- AI review queue (requires REDIS_URL) ---
# Reviews per instance run concurrently; failed jobs retry with backoff.
AI_REVIEW_CONCURRENCY=3
AI_REVIEW_JOB_ATTEMPTS=2

# --- Deployment (docker-compose.prod.yml) ---
# The production overlay runs images CI published to GHCR rather than building
# on the host. Set this to the commit SHA you are deploying; rolling back is
# changing it back and re-running `docker compose up -d`.
DEVCOLAB_IMAGE_TAG=
DEVCOLAB_REGISTRY=ghcr.io/om952
