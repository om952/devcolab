ENVIRONMENT=development
# No provider keys here: each review carries the user's own key in headers.
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=llama-3.1-8b-instant
# Required in production — must match collab-server's INTERNAL_API_KEY.
INTERNAL_API_KEY=
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
SENTRY_DSN=
DEBUG=false
