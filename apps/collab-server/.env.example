DATABASE_URL=postgresql://devcolab:devcolab@localhost:5433/devcolab
# Used by `prisma migrate` only, not by the app at runtime. Needed because a
# pooled connection (e.g. Neon's PgBouncer) can't run migrations — point this
# at an unpooled connection. For local/self-hosted Postgres, same as DATABASE_URL.
DIRECT_URL=postgresql://devcolab:devcolab@localhost:5433/devcolab
# Generate with: openssl rand -hex 32
# The server refuses to boot in production if this is left at a known default.
JWT_SECRET=dev-only-secret-replace-me-32chars
JWT_EXPIRES_IN=7d
PORT=4000
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
# Required in production. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=
SENTRY_DSN=
REDIS_URL=
# Proxy hops to trust for client IPs (0 when exposed directly).
TRUST_PROXY=0
JSON_BODY_LIMIT=2mb
AI_REVIEW_TIMEOUT_MS=60000
AI_REVIEW_CONCURRENCY=3
AI_REVIEW_JOB_ATTEMPTS=2
LOG_LEVEL=
