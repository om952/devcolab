{
  "name": "devcolab",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @devcolab/web dev",
    "dev:collab": "pnpm --filter @devcolab/collab-server dev",
    "build:web": "pnpm --filter @devcolab/web build",
    "build:collab": "pnpm --filter @devcolab/collab-server build",
    "build:types": "pnpm --filter @devcolab/shared-types build",
    "typecheck": "pnpm --filter @devcolab/collab-server typecheck",
    "test": "pnpm --filter @devcolab/collab-server test",
    "test:ai": "cd apps/ai-service && python -m pytest -q",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@prisma/client": "5.14.0",
    "prisma": "5.14.0"
  }
}
