generator client {
  provider = "prisma-client-js"
  // The runtime images are node:20-alpine (musl libc, OpenSSL 3.x). Without
  // these targets Prisma emits only the build host's engine, so the container
  // fails at the first query with "Error loading shared library libssl.so.1.1"
  // and every database call — including the readiness probe — fails.
  // Both architectures are listed so an arm64 build machine and an amd64
  // production host produce the same working image.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's pooled connection (DATABASE_URL) goes through PgBouncer, which
  // doesn't support the advisory locks Prisma Migrate needs. DIRECT_URL lets
  // migrations bypass the pooler while the app keeps using the pooled one.
  // Required whenever migrations run — for self-hosted Postgres (no pooler)
  // just set it to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole @default(reviewer)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessionsCreated Session[]       @relation("SessionCreator")
  participants    SessionParticipant[]
  comments        Comment[]
  cursors         CursorPresence[]
  aiReviewRuns    AIReviewRun[]  @relation("AIReviewTrigger")

  @@map("users")
}

enum UserRole {
  author
  reviewer
  ai_reviewer
}

model Session {
  id            String        @id @default(uuid())
  title         String
  description   String?
  repositoryUrl String?       @map("repository_url")
  status        SessionStatus @default(active)
  createdById   String        @map("created_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  creator       User                 @relation("SessionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  participants  SessionParticipant[]
  comments      Comment[]
  cursors       CursorPresence[]
  codeFiles     CodeFile[]
  aiReviews     AIReview[]
  aiReviewRuns  AIReviewRun[]

  @@index([createdById])
  @@index([updatedAt])
  @@map("sessions")
}

enum SessionStatus {
  active
  completed
  archived
}

model SessionParticipant {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  userId    String   @map("user_id")
  joinedAt  DateTime @default(now()) @map("joined_at")
  leftAt    DateTime? @map("left_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@map("session_participants")
}

model CodeFile {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  filePath  String   @map("file_path")
  content   String
  language  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  session      Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  comments     Comment[]
  aiReviewRuns AIReviewRun[]

  @@unique([sessionId, filePath])
  @@map("code_files")
}

model Comment {
  id           String          @id @default(uuid())
  sessionId    String          @map("session_id")
  codeFileId   String?         @map("code_file_id")
  authorId     String          @map("author_id")
  authorType   CommentAuthorType @map("author_type")
  category     CommentCategory @default(general)
  content      String
  lineStart    Int?            @map("line_start")
  lineEnd      Int?            @map("line_end")
  filePath     String?         @map("file_path")
  parentId     String?         @map("parent_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  session  Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  codeFile CodeFile? @relation(fields: [codeFileId], references: [id], onDelete: Cascade)
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")

  @@index([sessionId, createdAt])
  @@index([codeFileId])
  @@index([parentId])
  @@map("comments")
}

enum CommentAuthorType {
  human
  ai
}

enum CommentCategory {
  bug
  security
  anti_pattern @map("anti-pattern")
  test
  general
}

model CursorPresence {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  userId    String   @map("user_id")
  filePath  String?  @map("file_path")
  line      Int?
  column    Int?
  color     String   @default("#10b981")
  updatedAt DateTime @updatedAt @map("updated_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@map("cursor_presence")
}

/// One row per agent per review run. `result` holds that agent's raw findings
/// as JSON so a run can be inspected after the fact without re-running the LLM.
model AIReview {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  runId     String?  @map("run_id")
  agentType AgentType @map("agent_type")
  status    AIReviewStatus @default(pending)
  result    String?
  issueCount Int     @default(0) @map("issue_count")
  error     String?
  durationMs Int?    @map("duration_ms")
  filePath  String?  @map("file_path")
  lineStart Int?     @map("line_start")
  lineEnd   Int?     @map("line_end")
  severity  Severity? @default(info)
  createdAt DateTime @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  session Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  run     AIReviewRun? @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([runId])
  @@map("ai_reviews")
}

/// A single end-to-end review request. Groups the four per-agent AIReview rows
/// and carries the job lifecycle so a crashed or slow run is observable and
/// recoverable rather than silently lost.
model AIReviewRun {
  id            String            @id @default(uuid())
  sessionId     String            @map("session_id")
  codeFileId    String?           @map("code_file_id")
  triggeredById String            @map("triggered_by_id")
  status        AIReviewRunStatus @default(pending)
  engine        String?
  summary       String?
  totalIssues   Int               @default(0) @map("total_issues")
  degraded      Boolean           @default(false)
  error         String?
  createdAt     DateTime          @default(now()) @map("created_at")
  startedAt     DateTime?         @map("started_at")
  completedAt   DateTime?         @map("completed_at")

  session     Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  codeFile    CodeFile?  @relation(fields: [codeFileId], references: [id], onDelete: Cascade)
  triggeredBy User       @relation("AIReviewTrigger", fields: [triggeredById], references: [id], onDelete: Cascade)
  agentRuns   AIReview[]

  @@index([sessionId, createdAt])
  @@index([status])
  @@map("ai_review_runs")
}

enum AIReviewRunStatus {
  pending
  running
  completed
  failed
}

enum AgentType {
  bug_detection
  security_scan
  anti_pattern
  test_generation
}

enum AIReviewStatus {
  pending
  running
  completed
  failed
}

enum Severity {
  critical
  high
  medium
  low
  info
}
